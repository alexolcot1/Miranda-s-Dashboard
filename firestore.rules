rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Shared store for Miranda's Closet Plus team and collaborators
    match /stores/{storeId}/data/{docId} {
      allow read, write: if isSignedIn() && isValidId(storeId) && isValidId(docId);
    }

    // User private store path (backwards-compatible)
    match /users/{userId}/store/{storeId} {
      allow read, write: if isOwner(userId) && isValidId(storeId);
    }
  }
}
